node_modules/
dist/
*.tsbuildinfo

# Local diagnostics and generated review artifacts. These are intentionally
# kept outside commits because they can contain paths, timings, screenshots,
# or provider error output from a developer session.
*.log
/artifacts/
/.dme-spyx/
/HANDOFF-GOLDEN-MASTER.md
/tmp-*

# Copied into each package at pack time by scripts/prepack.mjs. The originals
# live at the repository root.
packages/*/LICENSE
packages/*/NOTICE
packages/*/README.md
*.tgz

# The local store: containers, layers, sessions, audit log.
.plif/
/model-cache.json

# Credentials, in any of the shapes people reach for.
.env
.env.*
*.pem
*.key

# Agent session transcripts and scratch dumps. These carry conversations,
# absolute paths and email addresses, and one of them reached the first commit
# of this repository before anyone noticed.
History.txt
*-this-session-is-being-continued-*.txt
packages/cli/*-local-command-*.txt

# Local development notes and working documents — not part of the repo.
docs/dev/

{
  "name": "plif-workspace",
  "version": "0.3.6",
  "private": true,
  "type": "module",
  "description": "Workspace root for plif. The published packages live in packages/.",
  "license": "Apache-2.0",
  "author": "Anthophicous",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnThophicous/plif.git"
  },
  "engines": {
    "node": ">=20.11"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "dev": "node --import tsx packages/cli/src/main.tsx",
    "typecheck": "tsc --build --force",
    "test": "node --import tsx --test packages/core/test/*.test.ts packages/sandbox/test/*.test.ts packages/cli/test/*.test.ts",
    "preview": "node --import tsx packages/cli/dev/preview.mts",
    "link": "npm run build && npm link --workspace @plif/cli",
    "unlink": "npm unlink -g @plif/cli"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "zod": "^4.4.3"
  }
}

{
  "name": "plif-workspace",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Workspace root for plif. The published packages live in packages/.",
  "license": "Apache-2.0",
  "author": "Anthophicous",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnThophicous/plif.git"
  },
  "engines": {
    "node": ">=20.11"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "postinstall": "node scripts/patch-slate-text.mjs && node scripts/patch-slate-scroll.mjs",
    "build": "tsc --build && npm run bundle",
    "clean": "tsc --build --clean",
    "dev": "node --import tsx packages/cli/src/main.tsx",
    "typecheck": "tsc --build --force",
    "test": "node --import tsx --test \"packages/core/test/*.test.ts\" \"packages/sandbox/test/*.test.ts\" \"packages/cli/test/*.test.ts\" \"packages/cli/test/*.test.tsx\" \"packages/core/test/*.test.tsx\" \"packages/acp/test/*.test.ts\" \"packages/mcp/test/*.test.ts\"",
    "preview": "node --import tsx packages/cli/dev/preview.mts",
    "link": "npm run build && npm link --workspace @plif/cli",
    "unlink": "npm unlink -g @plif/cli",
    "bundle": "node scripts/bundle.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "chromium-bidi": "^0.7.1",
    "esbuild": "^0.28.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "zod": "^4.4.3"
  }
}

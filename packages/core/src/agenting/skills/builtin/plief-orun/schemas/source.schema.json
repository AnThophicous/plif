{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pli'ef Orun Source",
  "type": "object",
  "required": [
    "id",
    "name",
    "type",
    "official_source",
    "last_verified",
    "verification_status",
    "confidence"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "type": {
      "type": [
        "string",
        "array"
      ]
    },
    "official_source": {
      "type": [
        "string",
        "null"
      ]
    },
    "repository": {
      "type": [
        "string",
        "null"
      ]
    },
    "documentation": {
      "type": [
        "string",
        "null"
      ]
    },
    "package": {
      "type": [
        "string",
        "null"
      ]
    },
    "registry": {
      "type": [
        "string",
        "null"
      ]
    },
    "cli": {
      "type": [
        "string",
        "null"
      ]
    },
    "current_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_verified": {
      "type": "string"
    },
    "framework_support": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "language": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "styling": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "runtime": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "installation_model": {
      "type": [
        "string",
        "null"
      ]
    },
    "license": {
      "type": [
        "string",
        "null"
      ]
    },
    "free_or_paid": {
      "type": [
        "string",
        "null"
      ]
    },
    "categories": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "integration_notes": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "verification_status": {
      "enum": [
        "VERIFIED_CURRENT",
        "VERIFIED_BUT_VERSION_UNKNOWN",
        "STALE",
        "UNVERIFIED",
        "DEPRECATED",
        "REMOVED"
      ]
    },
    "confidence": {
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW"
      ]
    },
    "collector_archetype": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "url",
          "authority",
          "claim"
        ],
        "properties": {
          "url": {
            "type": "string"
          },
          "authority": {
            "type": "string"
          },
          "claim": {
            "type": "string"
          }
        }
      }
    }
  },
  "additionalProperties": true
}
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pli'ef Orun Capability Record",
  "type": "object",
  "required": [
    "id", "name", "canonical_source", "official_docs", "repository", "package",
    "category", "capabilities", "limitations", "framework_support",
    "runtime_requirements", "browser_support", "SSR_constraints",
    "accessibility_characteristics", "performance_characteristics",
    "bundle_implications", "dependencies", "licensing", "maintenance_status",
    "API_stability", "integration_complexity", "adaptability", "design_flexibility",
    "best_for", "avoid_when", "alternatives", "known_conflicts", "verification_method",
    "source_evidence", "confidence", "last_verified", "volatility"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "name": {"type": "string", "minLength": 3},
    "canonical_source": {"type": "string", "minLength": 2},
    "official_docs": {"type": "string", "format": "uri"},
    "repository": {"type": ["string", "null"], "format": "uri"},
    "package": {"type": ["string", "null"]},
    "category": {"type": "string"},
    "capabilities": {"type": "array", "minItems": 2, "items": {"type": "string"}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "framework_support": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "runtime_requirements": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "browser_support": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "SSR_constraints": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "accessibility_characteristics": {"type": "array", "minItems": 2, "items": {"type": "string"}},
    "performance_characteristics": {"type": "array", "minItems": 2, "items": {"type": "string"}},
    "bundle_implications": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "licensing": {"type": "string"},
    "maintenance_status": {"enum": ["ACTIVE", "MAINTAINED", "LEGACY", "UNKNOWN"]},
    "API_stability": {"enum": ["STABLE", "EVOLVING", "UNKNOWN"]},
    "integration_complexity": {"enum": ["LOW", "MEDIUM", "HIGH", "UNKNOWN"]},
    "adaptability": {"enum": ["HIGH", "MEDIUM", "LOW", "UNKNOWN"]},
    "design_flexibility": {"enum": ["HIGH", "MEDIUM", "LOW", "UNKNOWN"]},
    "best_for": {"type": "array", "minItems": 2, "items": {"type": "string"}},
    "avoid_when": {"type": "array", "minItems": 2, "items": {"type": "string"}},
    "alternatives": {"type": "array", "items": {"type": "string"}},
    "known_conflicts": {"type": "array", "items": {"type": "string"}},
    "verification_method": {"type": "array", "minItems": 2, "items": {"type": "string"}},
    "source_evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
    "confidence": {"enum": ["HIGH", "MEDIUM", "LOW", "UNVERIFIED"]},
    "last_verified": {"type": "string", "format": "date"},
    "volatility": {"enum": ["LOW", "MEDIUM", "HIGH"]}
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["url", "claim", "state", "checked_at", "volatility"],
      "properties": {
        "url": {"type": "string", "format": "uri"},
        "claim": {"type": "string", "minLength": 20},
        "state": {"enum": ["VERIFIED", "INFERRED", "UNVERIFIED"]},
        "checked_at": {"type": "string", "format": "date"},
        "volatility": {"enum": ["LOW", "MEDIUM", "HIGH"]}
      }
    }
  }
}

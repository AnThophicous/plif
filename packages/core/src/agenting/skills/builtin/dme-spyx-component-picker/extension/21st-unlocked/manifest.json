{
  "manifest_version": 3,
  "name": "21st∞ — DME Spyx Bridge",
  "version": "1.1.0",
  "description": "Authorized 21st.dev browser capture + DME Spyx local handoff.",
  "permissions": [
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "https://21st.dev/*",
    "https://cdn.21st.dev/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://21st.dev/*"
      ],
      "js": [
        "src/shader-extract.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://cdn.21st.dev/*"
      ],
      "all_frames": true,
      "js": [
        "src/content-frame.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "21st∞ Prompt Unlocked"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}

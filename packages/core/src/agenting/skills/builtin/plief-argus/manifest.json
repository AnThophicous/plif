{
  "name": "Pli'ef Argus",
  "slug": "plief-argus",
  "version": "1.0.0",
  "description": "Security Intelligence & Verification System: SecurityIR model, traversable attack paths with control leverage, SecDiff for change review, Proof-of-Fix findings lifecycle, evidence-aware posture bands and machine-checkable release gates.",
  "entry": "SKILL.md",
  "artifacts": {
    "produced": [
      ".plif/artifacts/<task-id>/security-ir.json",
      ".plif/artifacts/<task-id>/attack-paths.json",
      ".plif/artifacts/<task-id>/security-diff.json",
      ".plif/artifacts/<task-id>/findings.jsonl"
    ],
    "consumed": [
      ".plif/artifacts/change-impact.json",
      ".plif/artifacts/repository-map.json",
      "_kernel/risk/autonomy.md"
    ]
  },
  "schemas": ["schemas/security-ir.schema.json", "schemas/finding.schema.json"],
  "engines_selftest": [
    "tools/argus_ir_lint.py", "tools/argus_attackpath.py",
    "tools/argus_sec_diff.py", "tools/argus_findings.py"
  ]
}

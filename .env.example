# ==============================================================================
# Plif Environment Configuration Example
# Copie este arquivo para .env e preencha conforme necessário:
#   cp .env.example .env
# ==============================================================================

# --- Configurações do Plif Web Terminal ---

# Interface de rede: 0.0.0.0 (todas as interfaces / rede local) ou 127.0.0.1 (somente local)
PLIF_WEB_HOST=0.0.0.0

# Porta do servidor web (padrão: 4173)
PLIF_WEB_PORT=4173

# Senha de acesso para a página de login no navegador
PLIF_WEB_PASSWORD=

# Limite de sessões simultâneas no navegador (padrão: 4)
PLIF_WEB_MAX_SESSIONS=4

# Caminho customizado do interpretador Python (opcional, caso use o bridge PTY)
# PLIF_PYTHON=python3

# --- Chaves de Modelos de IA (Opcional) ---
# Você também pode salvar chaves de forma criptografada usando `plif model set`
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# DEEPSEEK_API_KEY=
